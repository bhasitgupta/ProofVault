# ==============================================================================
# SDMS — Secure Digital Document Management System (SIH26190)
# Environment Configuration Template
# ==============================================================================

# Database (Supabase PostgreSQL / asyncpg connection string)
# e.g., postgresql+asyncpg://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite+aiosqlite:///sdms_metadata.db
SUPABASE_DB_URL=

# Supabase Cloud Project & Storage Buckets
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_KEY=<your-supabase-anon-or-service-key>
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>
SUPABASE_STORAGE_BUCKET=evidence
SUPABASE_QUARANTINE_BUCKET=quarantine
SUPABASE_CERTIFICATES_BUCKET=certificates

# Authentication & Security
JWT_SECRET_KEY=change-me-to-a-strong-random-secret-key-32-chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
MFA_REQUIRED=true
DEMO_MODE=true

# Polygon Amoy EVM Blockchain Provenance Engine (Chain ID 80002)
LEDGER_BACKEND=polygon
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology/
POLYGON_PRIVATE_KEY=
POLYGON_EVIDENCE_REGISTRY_ADDRESS=
POLYGON_PROVENANCE_REGISTRY_ADDRESS=

# Cryptographic Vault
VAULT_DEV_MODE=true
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=dev-root-token

# Local Fallback Object Storage Directories
STORAGE_DIR=storage_data
QUARANTINE_DIR=storage_data/quarantine

# Open Policy Agent (empty string enables embedded Python ABAC policy engine)
OPA_URL=

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=sdms_evidence
QDRANT_API_KEY=

# Cloud LLM API (Groq / OpenAI / OpenRouter - no local Ollama required)
LLM_API_KEY=
LLM_API_BASE=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
OLLAMA_URL=

# Frontend Configuration
VITE_API_URL=http://localhost:8000
