# ==============================================================================
# SDMS — Secure Digital Document Management System (SIH26190)
# Environment Configuration Template
# ==============================================================================

# Database
DATABASE_URL=sqlite+aiosqlite:///sdms_metadata.db

# Authentication & Security
JWT_SECRET_KEY=change-me-to-a-strong-random-secret-key-32-chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
MFA_REQUIRED=true
DEMO_MODE=true

# Ledger / Blockchain Engine ("polygon" for Polygon Amoy EVM, "dev" for SQLite DevLedger)
LEDGER_BACKEND=polygon
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology/
POLYGON_PRIVATE_KEY=
POLYGON_EVIDENCE_REGISTRY_ADDRESS=
POLYGON_PROVENANCE_REGISTRY_ADDRESS=

# Cryptographic Vault
VAULT_DEV_MODE=true
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=dev-root-token

# Encrypted Document Object Storage
STORAGE_DIR=storage_data
QUARANTINE_DIR=storage_data/quarantine

# Open Policy Agent (empty string enables embedded Python ABAC policy engine)
OPA_URL=

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=sdms_evidence
QDRANT_API_KEY=

# Local LLM / RAG Engine
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen2.5:1.5b

# Optional Cloud LLM (OpenAI-compatible)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Frontend Configuration
VITE_API_URL=http://localhost:8000
