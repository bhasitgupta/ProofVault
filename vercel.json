{
  "cleanUrls": true,
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "cleanUrls": true,
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
